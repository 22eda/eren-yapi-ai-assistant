# Örnek ortam değişkenleri. Gerçek sırları buraya yazma.
# Kullanım: bu dosyayı .env olarak kopyala, değerleri oraya doldur.
# .env Git'e gitmez; bu örnek dosya gidebilir.

# Uygulama ortamı: local | test | production
APP_ENV=local

# Geliştirme sunucusu (uvicorn komutundaki host/port ile aynı fikir)
APP_HOST=127.0.0.1
APP_PORT=8000

# Aşama 3'te eklenecek — şimdilik boş bırak
# LLM_API_KEY=

# Aşama 4'te eklenecek — şimdilik boş bırak
# ECOMMERCE_API_URL=
# ECOMMERCE_API_KEY=
